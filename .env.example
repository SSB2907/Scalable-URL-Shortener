# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

# --- Server ---
NODE_ENV=development
PORT=3000
# Public base URL used to build shortUrl in API responses.
BASE_URL=http://localhost:3000
LOG_LEVEL=info

# --- PostgreSQL (source of truth) ---
DATABASE_URL=postgres://urluser:urlpass@localhost:5432/urldb

# --- Redis (cache, rate limiting, idempotency, analytics queue) ---
REDIS_URL=redis://localhost:6379

# --- Short code generation ---
SHORT_CODE_LENGTH=7
SHORT_CODE_MAX_RETRIES=5

# --- Cache ---
CACHE_TTL_SECONDS=3600
REDIS_COMMAND_TIMEOUT_MS=150

# --- Rate limiting (POST /shorten) ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20

# --- Idempotency ---
IDEMPOTENCY_LOCK_TTL_SECONDS=60
IDEMPOTENCY_RESULT_TTL_SECONDS=86400

# --- Validation ---
MAX_URL_LENGTH=2048

# --- Analytics worker ---
ANALYTICS_QUEUE_KEY=click_events_queue
ANALYTICS_WORKER_BATCH_SIZE=50
ANALYTICS_WORKER_POLL_INTERVAL_MS=1000
