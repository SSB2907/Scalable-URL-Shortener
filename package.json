{
  "name": "scalable-url-shortener",
  "version": "2.0.0",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "worker": "node src/workers/analyticsWorker.js",
    "worker:dev": "nodemon src/workers/analyticsWorker.js",
    "migrate": "node db/migrate.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:coverage": "jest --runInBand --coverage",
    "load:redirect": "node tests/load/run.js redirect",
    "load:shorten": "node tests/load/run.js shorten"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "A scalable URL shortener with Redis caching, rate limiting, idempotent creation, and asynchronous click analytics.",
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.7.0",
    "nanoid": "^3.3.11",
    "pg": "^8.16.3",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "jest": "^29.7.0",
    "ioredis-mock": "^8.9.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.0.0"
  }
}
